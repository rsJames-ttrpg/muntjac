{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/rust-precommit-gate.sh",
            "if": "Bash(git commit *)",
            "timeout": 120,
            "statusMessage": "Running cargo fmt --check + cargo clippy..."
          }
        ]
      }
    ]
  }
}
