load("@prelude//toolchains:cxx.bzl", "system_cxx_toolchain")
load("@prelude//toolchains:python.bzl", "system_python_bootstrap_toolchain", "system_python_toolchain")

# The wheels under //third-party/python:* are cp312, so the interpreter
# must be a 3.12 cpython. The default ("python3" on PATH) is whatever
# the system ships, which on many distros is 3.13/3.14 - and a cp312
# wheel cannot be imported by a 3.14 interpreter.
#
# system_python_toolchain accepts either an absolute path or a bare
# command name. Using the bare name keeps the fixture portable across
# CI runners and dev machines, but requires the developer / CI runner
# to have `python3.12` on PATH. CI installs cp312 via `uv python
# install 3.12` and symlinks it to /usr/local/bin/python3.12 (see
# .github/workflows/ci.yml). Local dev: `ln -s "$(uv python find 3.12)"
# ~/.local/bin/python3.12` (or your distro's equivalent).
#
# The toolchains/ tree is committed but its contents are not regenerated
# by muntjac - they live alongside .buckconfig in the user's project
# skeleton.
_PY312 = "python3.12"

system_python_bootstrap_toolchain(
    name = "python_bootstrap",
    interpreter = _PY312,
    visibility = ["PUBLIC"],
)

system_python_toolchain(
    name = "python",
    interpreter = _PY312,
    visibility = ["PUBLIC"],
)

system_cxx_toolchain(
    name = "cxx",
    visibility = ["PUBLIC"],
)
