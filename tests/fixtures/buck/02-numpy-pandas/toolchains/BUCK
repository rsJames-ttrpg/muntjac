load("@prelude//toolchains:cxx.bzl", "system_cxx_toolchain")
load("@prelude//toolchains:python.bzl", "system_python_bootstrap_toolchain", "system_python_toolchain")

# The wheels under //third-party/python:* are cp312, so the interpreter
# must be a 3.12 cpython. The default ("python3" on PATH) is whatever the
# system ships, which on many distros is 3.13/3.14 - and a cp312 wheel
# cannot be imported by a 3.14 interpreter.
#
# This path was the only locally available 3.12 interpreter on the spike
# host (uv-managed). For CI, the right move is to install 3.12 via
# setup-python / `uv python install 3.12` and either:
#   1. symlink python3.12 onto PATH and set `_PY312 = "python3.12"`, or
#   2. resolve the path at config time (e.g. via $UV_PYTHON_312 buckconfig).
# The toolchains/ tree is committed but its contents are not regenerated by
# muntjac - they live alongside .buckconfig in the user's project skeleton.
_PY312 = "/home/jackm/.local/share/uv/python/cpython-3.12.0-linux-x86_64-gnu/bin/python3.12"

system_python_bootstrap_toolchain(
    name = "python_bootstrap",
    interpreter = _PY312,
    visibility = ["PUBLIC"],
)

system_python_toolchain(
    name = "python",
    interpreter = _PY312,
    visibility = ["PUBLIC"],
)

system_cxx_toolchain(
    name = "cxx",
    visibility = ["PUBLIC"],
)
